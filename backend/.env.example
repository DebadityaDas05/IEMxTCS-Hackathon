# ==============================================================================
# Enterprise Knowledge Assistant — Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Application Secret Key (Replace with a cryptographically secure 32+ char key in production)
SECRET_KEY=iem-tcs-enterprise-knowledge-assistant-default-key-change-in-prod

# API Key Authentication (Optional enterprise security toggle)
# Set to 'true' to require X-API-Key header on all /api endpoints
API_KEY_ENABLED=false
API_KEY=your-enterprise-secure-api-key-here

# Allowed CORS Origins (comma-separated list of trusted client origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25

# Input Validation Limits
MAX_QUESTION_LENGTH=1000

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ChromaDB Vector Store Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=knowledge_base

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
RELEVANCE_THRESHOLD=0.3
